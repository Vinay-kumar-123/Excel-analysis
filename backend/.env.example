# ==============================================
# Backend Environment Configuration Template
# Excel Analytics Server
# ==============================================

# Server Port
PORT=8000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB Connection String
# Example: mongodb://localhost:27017/excel-analytics or mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname
MONGO_URI=your_mongodb_connection_string

# JWT Secret Key for Authentication Tokens
SECRET_KEY=replace_with_a_strong_random_secret

# Google Gemini AI API Key (required for spreadsheet insights endpoint /api/v1/user/gemni)
GEMNI_AI_API=your_gemini_api_key

# Cloudinary Storage Configuration (required for profile photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
